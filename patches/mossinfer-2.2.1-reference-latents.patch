+// RunSpec::reference_latents: their count, shapes, values and the run layouts the DiT's reference path takes.
+void validate_references(const RunSpec& spec, int latents) {
+  const auto& refs = spec.reference_latents;
+  if (refs.empty()) return;
+  if (refs.size() > static_cast<std::size_t>(kMaxReferenceImages)) {
+    throw std::invalid_argument("At most " + std::to_string(kMaxReferenceImages) + " reference latents.");
+  }
+  for (std::size_t i = 0; i < refs.size(); ++i) {
+    const RunSpec::ReferenceLatent& ref = refs[i];
+    const std::string what = "reference_latents[" + std::to_string(i) + "]";
+    if (ref.height < 1 || ref.width < 1 ||
+        ref.data.size() != static_cast<std::size_t>(moss_dit::kLatentChannels) * ref.height * ref.width) {
+      throw std::invalid_argument(what + ": expected f32[" + std::to_string(moss_dit::kLatentChannels) + ", h, w].");
+    }
+    if (!std::all_of(ref.data.begin(), ref.data.end(), [](float v) { return std::isfinite(v); })) {
+      throw std::invalid_argument(what + ": the latents must be finite.");
+    }
+  }
+  const std::int64_t tokens = reference_tokens(spec);
+  if (tokens > moss_dit::kMaxReferenceTokens) {
+    throw std::invalid_argument("The reference latents take " + std::to_string(tokens) + " tokens; at most " +
+                                std::to_string(moss_dit::kMaxReferenceTokens) + ".");
+  }
+  if (latents != 1 || spec.crops) {
+    throw std::invalid_argument("Reference latents need a run on latent 0 alone, without MI_RUN_CROPS.");
+  }
+  if (spec.guidance == GuidanceMode::kMoss && spec.slg_scale > 0 && !spec.slg_layers.empty()) {
+    throw std::invalid_argument("Reference latents do not work with an SLG row (slg_scale > 0).");
+  }
+}
